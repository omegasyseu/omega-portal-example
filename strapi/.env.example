# Copy to .env and replace every "tobemodified" with a random value, e.g. from
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Use different values in every environment, and never commit .env.

# Server
HOST=0.0.0.0
PORT=1337

# The portal's origin (scheme, host and port, no trailing slash). Browsers may call
# the API only from this origin; unset, from none. Local development needs it. The
# portal image leaves it unset, as the portal reads Strapi on its own origin.
PORTAL_ORIGIN=http://localhost:3000

# The environment's IPS URL, the same as the portal's IPS_API. The Brand list's
# "Refresh from IPS" reads IPS's brands from it. `pnpm dev:all` passes the portal's
# IPS_API to Strapi, overriding this; the portal image falls back to PORTAL_IPS_API.
IPS_API=

# Secrets
APP_KEYS="tobemodified1,tobemodified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Admin panel flags (optional, default true)
FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true
