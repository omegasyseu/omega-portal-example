{
  "kind": "collectionType",
  "collectionName": "games",
  "info": {
    "singularName": "game",
    "pluralName": "games",
    "displayName": "Game",
    "description": "A game in the shared catalogue. Brands list games in their lobby. Its category is its Game Category; the portal opens a sportsbook differently (isSportsbook in the portal's src/components/games/game-view/sportsbook.ts)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "unique": true
    },
    "provider": {
      "type": "string",
      "required": true
    },
    "gameId": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["slots", "sportsbook"],
      "required": true
    },
    "tile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
