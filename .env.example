# Variables not prefix with VITE_ will be read at runtime using vite-plugin-runtime
IPS_API=https://ps.example.com/ps/ips
AMS_API=https://core.example.com/ams
GAME_LAUNCH_BASE_URL=https://ps.example.com/ps/game/GameContainer.action
# The environment's Strapi, no trailing slash. Each Brand's theme, logo, banners, lobby, Collections and Payment Methods come from it.
STRAPI_URL=http://localhost:1337
# The server's date.pattern registry: the Java pattern IPS returns dates in (e.g. MM-dd-yyyy HH:mm:ss).
# The date part is enough (time is read as HH:mm:ss). Empty = dd-MM-yyyy. One value per environment,
# matching the IPS server, so it stays a setting here rather than moving to Strapi.
DATE_PATTERN=
# Chronos in-app notifications (optional). Origin of chronos-engine, e.g. wss://chronos.example.com
# The app appends /websocket/private and /websocket/channel/<id>. Leave empty to disable.
CHRONOS_SOCKET_URL=
# Optional private channel filter: channel store ids, digits and commas, no spaces (e.g. 3,4). Empty = all private channels.
CHRONOS_CHANNEL_IDS=
# Optional public channel store ids to subscribe to, digits and commas, no spaces (e.g. 7,8). Empty = no public channels.
CHRONOS_PUBLIC_CHANNEL_IDS=
