{
	"name": "portal-5-vite",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite --port=3000",
		"dev:strapi": "pnpm --dir strapi develop",
		"dev:all": "node scripts/dev-all.ts",
		"build": "tsc && tsc -p tsconfig.scripts.json && vite build",
		"lint": "biome lint ./src ./scripts",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write ./src ./scripts",
		"biome:check": "biome check --write ./src ./scripts",
		"ci": "biome ci ./src ./scripts",
		"fix": "pnpm format && pnpm biome:check",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource-variable/outfit": "^5.3.0",
		"@gsap/react": "^2.1.2",
		"@mantine/carousel": "^9.6.3",
		"@mantine/core": "^9.6.3",
		"@mantine/dates": "^9.6.3",
		"@mantine/dropzone": "^9.6.3",
		"@mantine/form": "^9.6.3",
		"@mantine/hooks": "^9.6.3",
		"@mantine/modals": "^9.6.3",
		"@mantine/notifications": "^9.6.3",
		"@pay-com/js": "^1.2.7",
		"@tabler/icons-react": "^3.48.0",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-query-persist-client": "^5.104.0",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-table": "^9.2.4",
		"axios": "^1.20.0",
		"currency-formatter": "^1.5.9",
		"dayjs": "^1.11.23",
		"embla-carousel": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"gsap": "^3.15.0",
		"idb-keyval": "^6.3.0",
		"motion": "^14.0.0",
		"paymentiq-cashier-bootstrapper": "^1.7.10",
		"qs": "^6.16.0",
		"react": "^19.3.0",
		"react-cookie": "^8.1.2",
		"react-countup": "^6.5.3",
		"react-dom": "^19.3.0",
		"react-international-phone": "^4.8.0",
		"react-use-websocket": "^4.13.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tanstack/react-query-devtools": "^5.104.0",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.42",
		"@types/currency-formatter": "^1.5.4",
		"@types/node": "^24.19.0",
		"@types/qs": "^6.15.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.28",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vite-plugin-runtime": "^1.4.0",
		"vitest": "^5.0.3"
	},
	"lint-staged": {
		"{src,scripts}/**/*.{ts,tsx,js,jsx,json}": "biome check --write --no-errors-on-unmatched"
	}
}
