# The portal's settings for the portal image. Copy to portal.env next to docker-compose.yml
# and replace the example values with the environment's. An empty value clears the
# placeholder. PORTAL_STRAPI_URL is already /strapi (Strapi in the same container).
PORTAL_IPS_API=https://ps.example.com/ps/ips
PORTAL_AMS_API=https://core.example.com/ams
PORTAL_GAME_LAUNCH_BASE_URL=https://games.example.com
PORTAL_ENABLE_QUICK_SIGNUP_LINK=true
PORTAL_DATE_PATTERN=dd-MM-yyyy
PORTAL_CHRONOS_SOCKET_URL=
PORTAL_CHRONOS_CHANNEL_IDS=
PORTAL_CHRONOS_PUBLIC_CHANNEL_IDS=
